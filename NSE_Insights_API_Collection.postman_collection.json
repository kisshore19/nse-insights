{
  "info": {
    "_postman_id": "nse-insights-api-v2",
    "name": "NSE Insights API",
    "description": "Complete API collection for NSE Insights — Bhav Data Ingestion, Index Data Ingestion, Stock Explorer, Candle Stats, and Index Candle Stats.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "latestDate",
      "value": "2026-04-28",
      "type": "string",
      "description": "ISO date (yyyy-MM-dd) used as default for single-date requests"
    },
    {
      "key": "fromDate",
      "value": "2026-04-01",
      "type": "string"
    },
    {
      "key": "toDate",
      "value": "2026-04-28",
      "type": "string"
    },
    {
      "key": "symbol",
      "value": "RELIANCE",
      "type": "string"
    },
    {
      "key": "indexName",
      "value": "NIFTY50",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Bhav Data Ingestion",
      "description": "Download and manage NSE equity bhav copy data (sec_bhavdata_full_DDMMYYYY.csv)",
      "item": [
        {
          "name": "Download — Single Date",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "download"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromTradeDate\": \"{{latestDate}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Download bhav data for a single trading date."
          }
        },
        {
          "name": "Download — Date Range",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "download"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromTradeDate\": \"{{fromDate}}\",\n  \"toTradeDate\": \"{{toDate}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Download bhav data for all dates in the given range (parallel)."
          }
        },
        {
          "name": "Download — Overwrite Existing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "download"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromTradeDate\": \"{{latestDate}}\",\n  \"overwrite\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Force re-download and overwrite existing records for the date."
          }
        },
        {
          "name": "Get Status by Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/status/{{latestDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "status", "{{latestDate}}"]
            },
            "description": "Check if bhav data is downloaded for a specific date."
          }
        },
        {
          "name": "Get Available Dates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/available-dates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "available-dates"]
            },
            "description": "List all trading dates that have been successfully downloaded."
          }
        },
        {
          "name": "Get Download History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/history?page=0&size=20&status=ALL",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "history"],
              "query": [
                { "key": "page",   "value": "0" },
                { "key": "size",   "value": "20" },
                { "key": "status", "value": "ALL", "description": "ALL | SUCCESS | FAILED | DELETED" }
              ]
            },
            "description": "Paginated download audit log. Filter by status: ALL, SUCCESS, FAILED, DELETED."
          }
        },
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "summary"]
            },
            "description": "Overall ingestion stats — total dates, latest date, record count."
          }
        },
        {
          "name": "Delete Data by Date",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/ingestion/{{latestDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ingestion", "{{latestDate}}"]
            },
            "description": "Delete all bhav records for a specific trading date."
          }
        }
      ]
    },
    {
      "name": "2. Index Data Ingestion",
      "description": "Download and manage NSE daily index close data (ind_close_all_DDMMYYYY.csv from nsearchives.nseindia.com)",
      "item": [
        {
          "name": "Download — Single Date",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "download"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromTradeDate\": \"{{latestDate}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Download index close data (OHLC, P/E, P/B, Div Yield) for all NSE indices on a single date."
          }
        },
        {
          "name": "Download — Date Range",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "download"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromTradeDate\": \"{{fromDate}}\",\n  \"toTradeDate\": \"{{toDate}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Download index close data for all dates in range (parallel, skips weekends/holidays automatically on 404)."
          }
        },
        {
          "name": "Download — Overwrite Existing",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/download",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "download"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromTradeDate\": \"{{latestDate}}\",\n  \"overwrite\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Force re-download for a date even if already exists in DB."
          }
        },
        {
          "name": "Get Status by Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/status/{{latestDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "status", "{{latestDate}}"]
            },
            "description": "Check if index close data is downloaded for a specific date."
          }
        },
        {
          "name": "Get Available Dates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/available-dates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "available-dates"]
            },
            "description": "List all dates for which index close data exists in the DB."
          }
        },
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "summary"]
            },
            "description": "Total dates, latest/oldest date, total records for index close data."
          }
        },
        {
          "name": "Delete Data by Date",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-ingestion/{{latestDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-ingestion", "{{latestDate}}"]
            },
            "description": "Delete all index close records for a specific date."
          }
        }
      ]
    },
    {
      "name": "3. Index Constituents",
      "description": "Sync NSE index constituent data (index_master table). Run POST /sync once before using grouped-by-index or index-filtered screener APIs.",
      "item": [
        {
          "name": "Sync All Indices",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-constituents/sync",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-constituents", "sync"],
              "query": [
                { "key": "force", "value": "false", "disabled": true, "description": "true to bypass cache and re-download from NSE" }
              ]
            },
            "description": "Download constituent CSVs from NSE and upsert all 12 supported indices (NIFTY50, NIFTYNEXT50, NIFTY100, NIFTY200, NIFTY500, NIFTYMIDCAP50, NIFTYMIDCAP100, NIFTYMIDCAP150, NIFTYSMALLCAP50, NIFTYSMALLCAP100, NIFTYSMALLCAP250, NIFTYLARGEMIDCAP250) into index_master. Run this once before using any index-filtered APIs."
          }
        },
        {
          "name": "Sync All Indices — Force Refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-constituents/sync?force=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-constituents", "sync"],
              "query": [
                { "key": "force", "value": "true" }
              ]
            },
            "description": "Bypass the local cache and re-download all constituent CSVs from NSE. Use when index composition changes."
          }
        },
        {
          "name": "Sync Single Index",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-constituents/sync/{{indexName}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-constituents", "sync", "{{indexName}}"],
              "query": [
                { "key": "force", "value": "false", "disabled": true }
              ]
            },
            "description": "Sync constituents for a single index only. indexName examples: NIFTY50, NIFTYBANK, NIFTY100, NIFTYMIDCAP50."
          }
        },
        {
          "name": "Sync Single Index — Force Refresh",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-constituents/sync/{{indexName}}?force=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-constituents", "sync", "{{indexName}}"],
              "query": [
                { "key": "force", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "List Synced Indices",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/index-constituents/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "index-constituents", "list"]
            },
            "description": "Returns all indices that have been synced with their active constituent counts, plus the full list of supported index names."
          }
        }
      ]
    },
    {
      "name": "4. Stock Explorer",
      "description": "Query, filter, and explore stock price data. Supports index and sector filtering.",
      "item": [
        {
          "name": "Search Stocks — All (no filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks?page=0&size=50&sortBy=pctChange&sortDir=DESC",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks"],
              "query": [
                { "key": "date",           "value": "",    "disabled": true, "description": "dd-MM-yyyy (default: latest)" },
                { "key": "index",          "value": "",    "disabled": true, "description": "e.g. NIFTY50 — filter to index constituents" },
                { "key": "sector",         "value": "",    "disabled": true, "description": "e.g. Financial Services" },
                { "key": "minPrice",       "value": "",    "disabled": true, "description": "Minimum close price" },
                { "key": "maxPrice",       "value": "",    "disabled": true, "description": "Maximum close price" },
                { "key": "minVolume",      "value": "",    "disabled": true, "description": "Minimum traded quantity" },
                { "key": "minPctChange",   "value": "",    "disabled": true, "description": "Minimum % change" },
                { "key": "maxPctChange",   "value": "",    "disabled": true, "description": "Maximum % change" },
                { "key": "minDeliveryPct", "value": "",    "disabled": true, "description": "Minimum delivery %" },
                { "key": "page",           "value": "0" },
                { "key": "size",           "value": "50" },
                { "key": "sortBy",         "value": "pctChange",  "description": "pctChange | closePrice | tradedQuantity | tradeDate" },
                { "key": "sortDir",        "value": "DESC",       "description": "ASC | DESC" }
              ]
            },
            "description": "Advanced stock search with optional filters for date, index, sector, price range, volume, % change, and delivery %. Paginated and sortable."
          }
        },
        {
          "name": "Search Stocks — With Filters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks?minPrice=100&minPctChange=5&sortBy=pctChange&sortDir=DESC&page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks"],
              "query": [
                { "key": "date",           "value": "",    "disabled": true, "description": "dd-MM-yyyy (default: latest)" },
                { "key": "index",          "value": "",    "disabled": true, "description": "e.g. NIFTY50" },
                { "key": "minPrice",       "value": "100" },
                { "key": "minPctChange",   "value": "5" },
                { "key": "minDeliveryPct", "value": "",    "disabled": true },
                { "key": "page",           "value": "0" },
                { "key": "size",           "value": "50" },
                { "key": "sortBy",         "value": "pctChange" },
                { "key": "sortDir",        "value": "DESC" }
              ]
            },
            "description": "Stocks above ₹100 with min 5% change, sorted by % change desc."
          }
        },
        {
          "name": "Get Top Gainers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/top-gainers?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "top-gainers"],
              "query": [
                { "key": "date",  "value": "",    "disabled": true, "description": "dd-MM-yyyy (default: latest)" },
                { "key": "limit", "value": "10" },
                { "key": "index", "value": "",    "disabled": true, "description": "e.g. NIFTY50 — filter to index constituents only" }
              ]
            },
            "description": "Top gainers by % change. Optionally filter by index (requires index constituent sync)."
          }
        },
        {
          "name": "Get Top Gainers — Filtered by Index",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/top-gainers?limit=10&index=NIFTY50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "top-gainers"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "index", "value": "NIFTY50" }
              ]
            },
            "description": "Top gainers within NIFTY50 constituents only."
          }
        },
        {
          "name": "Get Top Losers",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/top-losers?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "top-losers"],
              "query": [
                { "key": "date",  "value": "",    "disabled": true, "description": "dd-MM-yyyy (default: latest)" },
                { "key": "limit", "value": "10" },
                { "key": "index", "value": "",    "disabled": true, "description": "e.g. NIFTY50" }
              ]
            },
            "description": "Top losers by % change."
          }
        },
        {
          "name": "Get Top Losers — Filtered by Index",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/top-losers?limit=10&index=NIFTY50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "top-losers"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "index", "value": "NIFTY50" }
              ]
            },
            "description": "Top losers within NIFTY50 constituents only."
          }
        },
        {
          "name": "Get Stocks by Index",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/by-index?index=NIFTY50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "by-index"],
              "query": [
                { "key": "index", "value": "NIFTY50", "description": "Required. Supported: NIFTY50, NIFTY100, NIFTY200, NIFTY500, NIFTYMIDCAP50, NIFTYMIDCAP100, etc." },
                { "key": "date",  "value": "",         "disabled": true, "description": "dd-MM-yyyy (default: latest)" }
              ]
            },
            "description": "All stocks belonging to a given index with their daily price data, sorted by % change desc."
          }
        },
        {
          "name": "Get Stock Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/{{symbol}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "{{symbol}}"],
              "query": [
                { "key": "date", "value": "", "disabled": true, "description": "dd-MM-yyyy (default: latest)" }
              ]
            },
            "description": "OHLC + volume + delivery data for a single symbol on a given date."
          }
        },
        {
          "name": "Get Available Dates",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/dates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "dates"]
            },
            "description": "All trading dates that have bhav data loaded."
          }
        },
        {
          "name": "Get Sectors",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/sectors",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "sectors"]
            },
            "description": "Distinct sector names from the index_master table."
          }
        },
        {
          "name": "Get Stocks Grouped by Index",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/grouped-by-index",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "grouped-by-index"],
              "query": [
                { "key": "date", "value": "", "disabled": true, "description": "dd-MM-yyyy (default: latest). e.g. 30-04-2026" }
              ]
            },
            "description": "Returns all synced indices, each with their constituent stocks and daily price data for the given date. Uses 2 DB queries regardless of index count. Stocks within each group are sorted by % change desc. Requires index_master to be populated — run POST /api/v1/index-constituents/sync first."
          }
        },
        {
          "name": "Get Stocks Grouped by Index — Specific Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/grouped-by-index?date=30-04-2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "grouped-by-index"],
              "query": [
                { "key": "date", "value": "30-04-2026", "description": "dd-MM-yyyy" }
              ]
            }
          }
        },
        {
          "name": "Get Stocks Grouped by Sector",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/grouped-by-sector",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "grouped-by-sector"],
              "query": [
                { "key": "date", "value": "", "disabled": true, "description": "dd-MM-yyyy (default: latest). e.g. 30-04-2026" }
              ]
            },
            "description": "Returns all sectors, each with their constituent stocks and the list of indices each stock belongs to. Stocks within each sector are sorted by % change desc. Sectors are sorted alphabetically. Each stock's 'indices' field shows e.g. [\"NIFTY50\", \"NIFTY100\"]. Requires index_master to be populated — run POST /api/v1/index-constituents/sync first."
          }
        },
        {
          "name": "Get Stocks Grouped by Sector — Specific Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stocks/grouped-by-sector?date=30-04-2026",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stocks", "grouped-by-sector"],
              "query": [
                { "key": "date", "value": "30-04-2026", "description": "dd-MM-yyyy" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5. Candle Stats",
      "description": "Build and query pre-computed OHLC + volume + delivery statistics per symbol per timeframe period.",
      "item": [
        {
          "name": "Build Stats — All Years",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/candles/stats/build?timeframe=YEAR",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "candles", "stats", "build"],
              "query": [
                { "key": "timeframe", "value": "YEAR" }
              ]
            },
            "description": "Build yearly stats for all symbols across all available years."
          }
        },
        {
          "name": "Build Stats — Specific Year",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/candles/stats/build?timeframe=YEAR&period=2024",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "candles", "stats", "build"],
              "query": [
                { "key": "timeframe", "value": "YEAR" },
                { "key": "period",    "value": "2024" }
              ]
            }
          }
        },
        {
          "name": "Build Stats — All Quarters",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/candles/stats/build?timeframe=QUARTER",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "candles", "stats", "build"],
              "query": [
                { "key": "timeframe", "value": "QUARTER" }
              ]
            }
          }
        },
        {
          "name": "Build Stats — Specific Quarter",
          "request": {
